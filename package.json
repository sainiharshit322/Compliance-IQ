{
  "name": "compliance-iq",
  "version": "1.0.0",
  "private": true,
  "description": "Agentic AI Compliance Automation and Audit Evidence Platform",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:portal": "npm run dev --workspace=apps/hitl_portal",
    "build:portal": "npm run build --workspace=apps/hitl_portal",
    "lint": "prettier --check \"**/*.{js,ts,jsx,tsx,json,md}\"",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,json,md}\"",
    "prisma:validate": "prisma validate --schema=database/schema.prisma"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "prisma": "^5.10.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
