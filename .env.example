# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Azure General Settings
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=

# Azure Storage Account (WORM Storage & Queues)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_QUEUE_NAME=evidence-jobs
AZURE_STORAGE_CONTAINER_NAME=evidence-worm
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# PostgreSQL Flexible Server (B1MS Free Tier)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=complianceiq
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_URL=postgresql://postgres:ChangeMeInProd123!@localhost:5432/complianceiq?sslmode=disable

# Azure Cosmos DB (Append-Only Audit Logs - 1000 RU/s Free Tier)
COSMOS_DB_ENDPOINT=
COSMOS_DB_PRIMARY_KEY=
COSMOS_DB_DATABASE_NAME=compliance_audit
COSMOS_DB_CONTAINER_NAME=audit_trails

# Azure OpenAI / OpenAI API Credentials
OPENAI_API_KEY=
OPENAI_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# GitHub API Credentials (Read-Only Scan)
GITHUB_PAT_TOKEN=

# Orchestrator API Gateway
ORCHESTRATOR_API_PORT=
ORCHESTRATOR_API_HOST=
